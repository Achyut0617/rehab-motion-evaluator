# Copy this file to .env and update with your phone's IP camera URL.
#
# Examples for CAMERA_SOURCE:
#   Android IP Webcam app (HTTP MJPEG): http://192.168.1.100:8080/video
#   DroidCam (HTTP MJPEG):              http://192.168.1.100:4747/video
#   RTSP stream:                        rtsp://192.168.1.100:8080/h264_ulaw.sdp
#   USB Webcam on Jetson:               0
#   Built-in synthetic demo mode:       demo
CAMERA_SOURCE=demo

# Frame resolution (640x480 recommended for Jetson Orin Nano real-time FPS)
FRAME_WIDTH=640
FRAME_HEIGHT=480

# Pose estimation backend: auto | mediapipe | yolo | demo
POSE_BACKEND=auto

# Optional: path to MediaPipe PoseLandmarker .task file (if using Tasks API)
MEDIAPIPE_MODEL_PATH=

# Optional: path to YOLOv8-pose .pt or TensorRT .engine file (if POSE_BACKEND=yolo)
YOLO_MODEL_PATH=yolov8n-pose.pt

# Flask server settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# ---- AI coach (free Google Gemini API) ----
# Get a free key (no credit card): https://aistudio.google.com/apikey
# Leave empty to use the built-in offline report templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
